{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:all",
      "type": "shell",
      "command": "pnpm --filter @vscode-liquid-paradox/server build && pnpm --filter vscode-liquid-paradox build",
      "options": {
        "env": {
          "NODE_ENV": "development"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "watch:server",
      "type": "shell",
      "command": "pnpm --filter @vscode-liquid-paradox/server build -- --watch",
      "options": {
        "env": {
          "NODE_ENV": "development"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
